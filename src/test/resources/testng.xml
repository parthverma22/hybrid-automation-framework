<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!-- Sequential full suite -->
<suite name="Hybrid Automation Suite" verbose="1">

    <listeners>
        <listener class-name="com.hybrid.listeners.TestListener"/>
    </listeners>

    <test name="UI Tests — SauceDemo">
        <classes>
            <class name="com.hybrid.ui.LoginTest"/>
            <class name="com.hybrid.ui.InventoryTest"/>
        </classes>
    </test>

    <test name="API Tests — reqres.in">
        <classes>
            <class name="com.hybrid.api.UserApiTest"/>
        </classes>
    </test>

    <test name="API Tests — Petstore">
        <classes>
            <class name="com.hybrid.api.PetApiTest"/>
        </classes>
    </test>

</suite>
